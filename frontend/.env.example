# Copy to .env only if you need to point the renderer at a non-default backend
# URL (e.g. a remote/staging API). Not needed for local dev — main.cjs and
# vite.config.ts already default to http://127.0.0.1:8000. In dev the page uses
# relative /api URLs which vite proxies to VITE_PROXY_TARGET (default below),
# so tunnels (cloudflared/ngrok) only need to expose the Vite port.
VITE_API_URL=http://127.0.0.1:8000
