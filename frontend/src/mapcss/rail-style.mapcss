way {
  color: #16a34a;
  width: 1.5;
  opacity: 0.7;
  z-index: 1;
}

way[status=running] {
  color: #d97706;
  width: 2.5;
  opacity: 0.95;
  z-index: 2;
}

way[status=blocked] {
  color: #dc2626;
  width: 3.5;
  casing-color: #7f1d1d;
  casing-width: 1.5;
  z-index: 3;
}

way[selected=yes] {
  color: #3b82f6;
  width: 4.5;
  z-index: 10;
}

node {
  symbol-shape: circle;
  symbol-size: 2.5;
  fill-color: #1f2937;
  text: name;
  z-index: 4;
}
