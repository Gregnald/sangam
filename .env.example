# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql+psycopg://sangam:sangam@localhost:5433/sangam

# Change this before any real deployment.
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRY_HOURS=12

API_HOST=127.0.0.1
API_PORT=8000

# Priority-score gap a new request needs over an already-scheduled one to be
# eligible to bump it (see optimizer/workflow.py).
PREEMPTION_MARGIN=15.0
